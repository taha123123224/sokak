; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SOKAK: Operasyon"
config/description="Modern FPS - Ölüm Maçı"
run/main_scene="res://scenes/main.tscn"
config/project_settings_override="user://grafik.cfg"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/bg_color=Color(0.03, 0.035, 0.045, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[audio]

driver/enable_input=true

[autoload]

GS="*res://scripts/gs.gd"
MatLib="*res://scripts/matlib.gd"
SFX="*res://scripts/sfx.gd"
Thumbs="*res://scripts/thumbs.gd"
Online="*res://scripts/online.gd"
Net="*res://scripts/net.gd"
Updater="*res://scripts/updater.gd"
Voice="*res://scripts/voice.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/staging_buffer/texture_upload_region_size_px=128
rendering_device/d3d12/max_resource_descriptors_per_frame=65536
rendering_device/d3d12/max_sampler_descriptors_per_frame=2048
rendering_device/d3d12/max_misc_descriptors_per_frame=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2
textures/default_filters/texture_mipmap_bias=-0.25
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.08, 1)
anti_aliasing/quality/screen_space_aa=1
occlusion_culling/use_occlusion_culling=true
